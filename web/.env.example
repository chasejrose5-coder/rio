NEXT_PUBLIC_RIO_API_URL=http://localhost:8000
# Public flag. true shows Continue with Google on Log in and Create account.
# Unset, false, or anything else hides the button. Not a secret.
# Set it on Vercel only after Supabase Google is enabled. See docs/google-auth-setup.md.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
# Server-only. Leave this empty on a laptop. The test site sets it to the
# Render origin (https, no path, no trailing slash). It is not NEXT_PUBLIC.
# See docs/migration/deploy-test.md.
RIO_API_ORIGIN=
