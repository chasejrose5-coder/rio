RIO_SUPABASE_URL=
RIO_SUPABASE_ANON_KEY=
RIO_SUPABASE_SERVICE_ROLE_KEY=
RIO_APP_URL=http://localhost:8501
# Optional. Unset keeps the Streamlit Google redirect (RIO_APP_URL + "/").
# Set this to the API callback when the new site should receive the return.
RIO_GOOGLE_REDIRECT_URI=
RIO_ADMIN_EMAIL=
RIO_STRAVA_CLIENT_ID=
RIO_STRAVA_CLIENT_SECRET=
# Optional. Unset keeps the Streamlit callback (RIO_APP_URL + "/").
# Set this when the new site's callback is registered with Strava.
RIO_STRAVA_REDIRECT_URI=
RIO_FRONTEND_ORIGIN=http://localhost:3000
