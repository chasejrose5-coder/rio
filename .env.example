RIO_SUPABASE_URL=
RIO_SUPABASE_ANON_KEY=
RIO_SUPABASE_SERVICE_ROLE_KEY=
RIO_APP_URL=http://localhost:8501
# Optional. Unset uses {RIO_FRONTEND_ORIGIN}/auth/callback.
# That is https://www.riorunning.com/auth/callback on the live API,
# and http://localhost:3000/auth/callback when the origin is unset.
# Set this only to send the Google return somewhere else.
RIO_GOOGLE_REDIRECT_URI=
RIO_ADMIN_EMAIL=
RIO_STRAVA_CLIENT_ID=
RIO_STRAVA_CLIENT_SECRET=
# Optional. Unset keeps the Streamlit callback (RIO_APP_URL + "/"),
# unless RIO_CALLBACK_BASE_URL is set. A full URI here wins over the base.
RIO_STRAVA_REDIRECT_URI=
# Public origin of the Next.js app. The Strava redirect is {base}/strava/callback.
# Live Render value: https://www.riorunning.com
# No path and no trailing slash. Strava's callback domain is www.riorunning.com.
RIO_CALLBACK_BASE_URL=
# The one browser origin CORS allows. Live Render value: https://www.riorunning.com
RIO_FRONTEND_ORIGIN=http://localhost:3000
